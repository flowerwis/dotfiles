{
	"layer": "top", // Waybar at top layer
	"position": "top", // Waybar position (top|bottom|left|right)
	// "height": 14, // Waybar height (to be removed for auto height)
	// "width": 1280, // Waybar width
	"reload_style_on_change": true,
	// Choose the order of the modules
	"modules-left": ["sway/workspaces", "sway/mode"],
	"modules-right": ["custom/update", "custom/separator", "temperature", "custom/separator", "load", "custom/separator", "memory", "custom/separator", "network", "custom/separator", "backlight", "custom/separator", "pulseaudio", "custom/separator", "clock", "custom/separator", "battery", "tray"],
	"sway/mode": {
		"format": "{}"
	},
    	"custom/update": {
        	"format": "<span color='#589df6'>󰚰 {} </span>",
        	"exec": "checkupdates | wc -l",
        	"interval": 3600,
        	"on-click": "foot dash -lc 'printf \"Beginning upgrade...\\n\"; sleep 0.5; yay -Syu; printf \"\\nUpgrade complete.\\nPress <Enter> to exit window.\\n\\n\"'",
		"tooltip": false,
        	"signal": 8
    	},
	"custom/disk_home": {
		"format": "🏠 {} ",
		"interval": 30,
		"exec": "df -h --output=avail $HOME | tail -1 | tr -d ' '"
	},
	"custom/disk_root": {
		"format": "💽 {} ",
		"interval": 30,
		"exec": "df -h --output=avail / | tail -1 | tr -d ' '"
	},
	"temperature": {
		"format-critical": "{temperatureC}°C {icon}",
		"format": "<span color='#e88939'>{icon}</span> {temperatureC}°C",
		"format-icons": [""],
		"interval": 5,
		"tooltip": false
	},
	"load": {
		"format": "󰘚 {load1}",
		"interval": 5,
		"tooltip": false
	},
	"memory": {
		"format": "󰍛 {used:0.1f}G",
		"interval": 5,
		"tooltip": false
	},
	"custom/mail": {
		"format": "📩{}",
		"interval": 30,
		"exec": "notmuch count tag:flagged OR tag:inbox AND NOT tag:killed"
	},
	"network": {
		"interface": "wlan0", // (Optional) To force the use of this interface
		"format-wifi": "<span color='#589df6'></span> <span color='gray'>{essid}</span> {frequency} <span color='#589df6'>{signaldBm} dB</span> <span color='#589df6'>⇵</span> {bandwidthUpBits}/{bandwidthDownBits}",
		"format-ethernet": "{ifname}: {ipaddr}/{cidr} ",
		"format-linked": "{ifname} (No IP)",
		"format-disconnected": "Disconnected",
		// "format-alt": "<span color='gray'>{ifname}</span>: <span color='#589df6'>{ipaddr}/{cidr} </span>", //
		"interval": 5,
		"on-click": "foot -T float nmtui",
		"tooltip": false
	},
	"backlight": {
		// "device": "acpi_video1",
		"format": "{icon} {percent}%",
		"format-icons": ["󰃞", "󰃟", "󰃠"],
		"on-scroll-up": "brightnessctl -e4 -n1 set 5%+",
		"on-scroll-down": "brightnessctl -e4 -n1 set 5%-",
		"tooltip": false
	},
	"pulseaudio": {
		"format": "{icon} {volume}% {format_source}",
        	"format-bluetooth": "󰂰 {volume}%",
        	"format-bluetooth-muted": "󰂲 {icon}",
		"format-source": " {volume}%",
		"format-source-muted": "",
        	"format-muted": "󰝟",
        	"format-icons": {
            	"headphone": "󰋋",
            	"hands-free": "󰥰",
            	"headset": "󰋎",
            	"phone": "󰏲",
            	"portable": "󰄝",
            	"car": "󰄋",
            	"default": ["󰕿", "󰖀", "󰕾"]
        },
		"on-click": "foot -T float wiremix",
		"tooltip": false
	},
	"clock": {
		"format": "󰥔 {:%H:%M}",
		"tooltip-format": "{:%Y-%m-%d}"
		// "format-alt": "{:%Y-%m-%d}"
	},
	"battery": {
		"states": {
			"warning": 20,
			"critical": 15
		},
		"format": "<span color='#e88939'>{icon}</span> {capacity}% ({time})",
		"format-charging": "<span color='#e88939'>󱐋</span> {capacity}%",
		"format-plugged":  "<span color='#e88939'></span> {capacity}%",
		// "format-good": "", // An empty format will hide the module
		"format-full": "<span color='#e88939'>󰁹</span> {capacity}% (Full)",
		"interval": 5,
	        "format-icons": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"]	
	},
	"battery#bat2": {
		"bat": "BAT2",
		"interval": 5
	},
	"tray": {
		// "icon-size": 21,
		"spacing": 8
	},
	"custom/separator": {
		"format": "|",
		"tooltip": false
	}
}
