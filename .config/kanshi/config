output "Chimei Innolux Corporation 0x14C9 Unknown" {
  mode 1920x1080@60.008
  position 0,0
  alias $INTERNAL
}

output "TEMPLATE" {
  mode 1920x1080@240
  position 1920,0
  alias $HOME_MONITOR
}

output HDMI-A-2 {
  mode 1920x1080@120
  position 1920,0
  alias $EXTERNAL
}

profile just_for_now {
  output $INTERNAL disable
  output $EXTERNAL enable
}

profile laptop {
    output eDP-1 enable mode 1920x1080@60.008
}
